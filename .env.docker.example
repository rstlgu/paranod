# Each Compose project receives its own database, network, volumes and images.
COMPOSE_PROJECT_NAME=paranod
APP_BIND_IP=127.0.0.1
APP_PORT=3002
APP_URL=http://localhost:3002
BETTER_AUTH_URL=http://localhost:3002

# Leave empty for Docker API negotiation. Override only for compatibility diagnostics.
DOCKER_API_VERSION=

POSTGRES_DB=paranod
POSTGRES_USER=paranod
POSTGRES_PASSWORD=replace-with-a-long-random-password

WORKSPACES_RUNNER_TOKEN=replace-with-a-long-random-runner-token
CRON_SECRET=replace-with-a-long-random-cron-token
MAINTENANCE_INTERVAL_MS=300000

# Optional retention for completed flow runs. 0 preserves all history.
FLOW_HISTORY_RETENTION_DAYS=0

# Optional. When omitted, a persistent key is generated in the app volume.
SECRETS_ENCRYPTION_KEY=

# Exact local/LAN addon hostnames or IPs, comma-separated. Keep empty for remote HTTPS addons.
PARANOD_ADDON_ALLOWED_HOSTS=
NEXT_PUBLIC_ADDON_STORE_URL=

# Opt-in graph agent: also set COMPOSE_PROFILES=agent, then add at least one
# provider key (OpenAI, Anthropic, Google, xAI, DeepSeek, Moonshot or
# OpenRouter) in Settings → Graph agent.
PARANOD_AGENT_WORKER_ENABLED=false
COMPOSE_PROFILES=
