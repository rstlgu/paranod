{
  "name": "paranod",
  "version": "2.0.0",
  "private": true,
  "description": "Open-source, self-hosted OSINT framework with a visual graph, modular tools and an AI agent.",
  "author": {
    "name": "Luigi Rosato",
    "url": "https://github.com/rstlgu"
  },
  "scripts": {
    "test:plugins": "node --test tests/plugins.test.cjs",
    "dev": "next dev",
    "build": "next build",
    "build:agent": "node scripts/build-agent-worker.mjs",
    "agent:worker": "node dist/agent-worker.cjs",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "docker:up": "docker/compose.sh up -d --build",
    "docker:down": "docker/compose.sh down",
    "docker:logs": "docker/compose.sh logs -f app",
    "test:security": "node --test tests/security.test.cjs",
    "test": "npm run test:node && npm run test:unit",
    "typecheck": "tsc --noEmit",
    "test:node": "node --test tests/*.test.cjs",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "lint-staged": {
    "**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ]
  },
