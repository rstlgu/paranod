# Local development only. Create an empty database and choose your own credentials.
DATABASE_URL=postgresql://paranod:replace-with-local-password@127.0.0.1:5432/paranod
DIRECT_URL=postgresql://paranod:replace-with-local-password@127.0.0.1:5432/paranod
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Generate independent values with: openssl rand -base64 48
BETTER_AUTH_SECRET=
SECRETS_ENCRYPTION_KEY=
TEMP_FILE_ENCRYPTION_KEY=
CRON_SECRET=
